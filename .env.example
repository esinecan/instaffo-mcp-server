# Copy to .env and adjust. All values are optional; defaults are shown.

# Where session material lives on disk (browser profile, storage state, captures).
# Defaults to ~/.instaffo-mcp
# INSTAFFO_MCP_HOME=~/.instaffo-mcp

# The candidate web app origin. Confirmed 2026-07-13 as app.instaffo.com.
# INSTAFFO_APP_ORIGIN=https://app.instaffo.com

# Headless browser for the server and auth checks (login is always headed).
# INSTAFFO_HEADLESS=true

# Minutes to wait for a manual login before giving up.
# INSTAFFO_LOGIN_TIMEOUT_MIN=10
